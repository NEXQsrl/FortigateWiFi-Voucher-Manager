# Ignore Node.js dependencies for both server and client
node_modules/
npm-debug.log*
yarn-error.log
pnpm-debug.log*

# Ignore Vite-specific build and cache directories
client/dist/
client/.vite/
client/.cache/

# Ignore log files
logs/
*.log
server/logs/
client/logs/
server/*.log
client/*.log
server/npm-debug.log
client/npm-debug.log

# Ignore environment files containing sensitive information
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore editor and OS-specific files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Ignore test coverage reports
coverage/
server/coverage/
client/coverage/

# Ignore Docker-related files
docker-compose.override.yml
.dockerignore
server/dist/
client/dist/

# Ignore build output directories
dist/
out/

# Ignore Azure DevOps and Terraform state files
.azure-pipelines/
terraform.tfstate
terraform.tfstate.backup
